# Optional. Empty = a random access key is generated in the persistent /data/admin-token.
# Generate a unique one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPER_TOKEN=

# Safe default: only the server's loopback interface. Use an SSH tunnel.
SCRAPER_BIND=127.0.0.1
SCRAPER_PORT=8000

# Only needed for: docker compose --profile https up -d
# Point this DNS name to your VPS and open ports 80/443 first.
SCRAPER_HOSTNAME=scraper.your-real-domain.co.uk
LOG_LEVEL=INFO
